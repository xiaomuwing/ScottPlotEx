<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ScottPlotEx.Controls</RootNamespace>
    <AssemblyName>ScottPlotEx.Controls</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>在 WinForms 用户控件中嵌入 ScottPlot，并提供“堆叠 / 跟随 / 手动”三种坐标轴滚动模式。</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ScottPlot.WinForms" Version="5.1.59" />
  </ItemGroup>

  <!-- NU1701：ScottPlot.WinForms 会传递引入仅支持 .NET Framework 的 OpenTK 3.1.0（仅 FormsPlotGL 使用，本控件并不使用）。 -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ScottPlotEx.Tests" />
  </ItemGroup>

</Project>
