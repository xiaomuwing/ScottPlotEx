<Project Sdk="Microsoft.NET.Sdk">

  <!-- 目标框架、WinForms、语言版本等公共设置见仓库根目录的 Directory.Build.props；包版本见 Directory.Packages.props。 -->
  <PropertyGroup>
    <RootNamespace>ScottPlotEx.Controls</RootNamespace>
    <AssemblyName>ScottPlotEx.Controls</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>在 WinForms 用户控件中嵌入 ScottPlot，并提供“堆叠 / 跟随 / 手动”三种坐标轴滚动模式。</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ScottPlot.WinForms" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ScottPlotEx.Tests" />
  </ItemGroup>

</Project>
